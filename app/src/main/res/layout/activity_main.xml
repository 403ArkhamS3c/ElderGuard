<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:padding="18dp">

    <!-- ========================================== -->
    <!-- LAYAR 1: TAMPILAN UTAMA MONITORING         -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Judul Aplikasi -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="ELDERGUARD"
            android:textColor="#58A6FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Status Koneksi & Monitoring -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Disconnected"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Kotak Indikator Sensor Live (ACC & Barometer) -->
        <TextView
            android:id="@+id/tvMetrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="#161B22"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="ACC: 0.00 G  |  P: -- hPa"
            android:textColor="#8B949E"
            android:textSize="11sp" />

        <!-- Tombol START (Hijau) -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="135dp"
            android:layout_height="40dp"
            android:backgroundTint="#238636"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tombol STOP (Abu-abu/Merah - Hanya muncul saat sensor berjalan) -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="135dp"
            android:layout_height="40dp"
            android:backgroundTint="#DA3633"
            android:enabled="false"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ========================================== -->
    <!-- LAYAR 2: LAYAR KONFIRMASI (FALL/NEAR-FALL) -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutAlert"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D1117"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAlertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="NEAR-FALL DETECTED"
            android:textColor="#F85149"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlertTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Are you OK? (15s)"
            android:textColor="#E6EDF3"
            android:textSize="12sp" />

        <!-- Tombol Besar I'M OK (Hijau Terang) -->
        <Button
            android:id="@+id/btnOk"
            android:layout_width="145dp"
            android:layout_height="42dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="#2EA043"
            android:text="I'M OK"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tombol Besar NEED HELP (Merah Terang) -->
        <Button
            android:id="@+id/btnHelp"
            android:layout_width="145dp"
            android:layout_height="42dp"
            android:backgroundTint="#DA3633"
            android:text="NEED HELP"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>